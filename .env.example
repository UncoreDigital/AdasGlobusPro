# ---------------------------------------------------------------------------
# ADAS Globus — environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit keys.
# ---------------------------------------------------------------------------

# Canonical origin for this deploy. Set it per environment so a preview build
# emits its own canonical tags — a preview that canonicalises to production can
# get itself dropped from the index in production's favour.
#
# THIS MUST BE THIS SITE'S OWN ORIGIN, never the parent's. It feeds the
# canonical tag, og:url, the sitemap, robots.txt and the Organization @id all
# at once, so pointing it at adasglobus.com tells search engines to index the
# parent instead of this site — which is exactly what happened once already.
# lib/origin.ts now refuses any adasglobus.com host and warns, but set it
# correctly rather than relying on the guard.
NEXT_PUBLIC_SITE_URL=https://www.adasglobuspro.com

# Supabase — Dashboard > Project Settings > API
# The anon key is safe in the browser: every table is protected by row-level
# security, and the policies in supabase/migrations/0001_init.sql are what
# actually enforce access. Never put the service_role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
