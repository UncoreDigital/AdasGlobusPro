# ---------------------------------------------------------------------------
# ADAS Globus — environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit keys.
# ---------------------------------------------------------------------------

# Canonical origin for this deploy. Set it per environment so a preview build
# emits its own canonical tags — a preview that canonicalises to production can
# get itself dropped from the index in production's favour.
NEXT_PUBLIC_SITE_URL=https://www.adasglobus.com

# Supabase — Dashboard > Project Settings > API
# The anon key is safe in the browser: every table is protected by row-level
# security, and the policies in supabase/migrations/0001_init.sql are what
# actually enforce access. Never put the service_role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
